<Application x:Class="StencilPad.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StencilPad">
    <Application.Resources>
        <ResourceDictionary>
            <BitmapImage x:Key="SelectionTool" UriSource="Resources/Icons/SelectionTool.png"/>
            <BitmapImage x:Key="EditTool" UriSource="Resources/Icons/EditTool.png"/>
            <BitmapImage x:Key="StraightLineTool" UriSource="Resources/Icons/StraightLineTool.png"/>
            <BitmapImage x:Key="MarkerPathTool" UriSource="Resources/Icons/MarkerPathTool.png"/>
            <BitmapImage x:Key="RulerTool" UriSource="Resources/Icons/RulerTool.png"/>
            <BitmapImage x:Key="TextTool" UriSource="Resources/Icons/TextTool.png"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
