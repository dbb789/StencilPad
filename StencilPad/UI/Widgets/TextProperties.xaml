<UserControl x:Class="StencilPad.UI.Widgets.TextProperties"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:widgets="clr-namespace:StencilPad.UI.Widgets"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="60"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="Font:" VerticalAlignment="Center"/>
        <widgets:FontNameComboBox Grid.Column="2"
                                  Value="{Binding FontName, ElementName=Root}"/>
        <widgets:FontSizeComboBox Grid.Column="4"
                                  Value="{Binding FontSize, ElementName=Root}"/>
    </Grid>
</UserControl>
