<widgets:ColorFieldSliderBase x:Class="StencilPad.UI.Widgets.ColorFieldBrightnessSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:widgets="clr-namespace:StencilPad.UI.Widgets"
             Height="16">
    <Grid ClipToBounds="True">
        <!-- Black-to-colour gradient -->
        <Rectangle x:Name="GradientRect"/>

        <!-- Drag canvas with marker -->
        <Canvas x:Name="DragCanvas" Background="Transparent">
            <Rectangle x:Name="Marker"
                       Width="4" Height="16"
                       Stroke="Black" StrokeThickness="1"
                       Fill="White" Opacity="0.8"
                       IsHitTestVisible="False"/>
        </Canvas>
    </Grid>
</widgets:ColorFieldSliderBase>
