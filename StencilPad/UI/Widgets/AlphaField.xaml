<UserControl x:Class="StencilPad.UI.Widgets.AlphaField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:widgets="clr-namespace:StencilPad.UI.Widgets"
             x:Name="Root"
             MinWidth="200">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Grid>
        <widgets:ColorFieldAlphaSlider x:Name="AlphaSlider"
                                        Value="{Binding Value, ElementName=Root, Mode=TwoWay}"
                                        BaseColor="White"/>
    </Grid>
</UserControl>
