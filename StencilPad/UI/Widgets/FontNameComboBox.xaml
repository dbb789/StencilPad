<UserControl x:Class="StencilPad.UI.Widgets.FontNameComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <ComboBox IsEditable="True"
              Text="{Binding Value, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
              ItemsSource="{Binding SortedFonts, ElementName=Root}">
        <ComboBox.ItemTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Source}" FontFamily="{Binding}"/>
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>
</UserControl>
