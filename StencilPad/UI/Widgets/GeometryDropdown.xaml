<UserControl x:Class="StencilPad.UI.Widgets.GeometryDropdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <ComboBox ItemsSource="{Binding Items, ElementName=Root}"
              SelectedIndex="{Binding SelectedIndex, ElementName=Root}">
        <ComboBox.ItemTemplate>
            <DataTemplate>
                <Viewbox Height="16" StretchDirection="DownOnly" Stretch="Fill">
                    <Grid>
                        <Path Data="{Binding Geometry}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                              StrokeThickness="1"
                              Fill="Transparent"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeDashArray="{Binding DashStyle.Dashes}"
                              StrokeDashOffset="{Binding DashStyle.Offset}"/>
                    </Grid>
                </Viewbox>
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>
</UserControl>
