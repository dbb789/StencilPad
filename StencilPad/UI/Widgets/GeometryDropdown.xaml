<UserControl x:Class="StencilPad.UI.Widgets.GeometryDropdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <ComboBox ItemsSource="{Binding Items, ElementName=Root}"
              SelectedIndex="{Binding SelectedIndex, ElementName=Root}">
        <ComboBox.ItemTemplate>
            <DataTemplate>
                <Viewbox Width="128" Height="16" StretchDirection="DownOnly" Stretch="Fill">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Data="{Binding}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                              StrokeThickness="1"
                              Fill="Black"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding}"/>
                    </Grid>
                </Viewbox>
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>
</UserControl>
