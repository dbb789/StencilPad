<UserControl x:Class="StencilPad.UI.Widgets.GeometryDropdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <ComboBox ItemsSource="{Binding Items, ElementName=Root}"
              SelectedIndex="{Binding SelectedIndex, ElementName=Root}">
        <ComboBox.ItemTemplate>
            <DataTemplate>
                <Viewbox Width="24" Height="16" Stretch="Uniform">
                    <Path Data="{Binding}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          StrokeThickness="1"
                          Fill="Transparent"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                </Viewbox>
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>
</UserControl>
