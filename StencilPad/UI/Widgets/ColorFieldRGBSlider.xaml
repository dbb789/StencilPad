<widgets:ColorFieldSliderBase x:Class="StencilPad.UI.Widgets.ColorFieldRGBSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:widgets="clr-namespace:StencilPad.UI.Widgets">
    <Grid ClipToBounds="True">
        <Rectangle x:Name="GradientRect"/>
        <Canvas x:Name="DragCanvas" Background="Transparent">
            <Rectangle x:Name="Marker"
                       Width="4" Height="20"
                       Stroke="Black" StrokeThickness="1"
                       Fill="White" Opacity="0.8"
                       IsHitTestVisible="False"/>
        </Canvas>
    </Grid>
</widgets:ColorFieldSliderBase>

