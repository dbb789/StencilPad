<UserControl x:Class="StencilPad.UI.Widgets.UnitField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StencilPad.UI.Widgets"
             xmlns:sp="clr-namespace:StencilPad.Spatial"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <local:BaseUnitField x:Name="ValueField"
                             Grid.Column="0"
                             VerticalContentAlignment="Center"
                             Padding="2"
                             Value="{Binding Value, ElementName=Root}"
                             UnitType="{Binding UnitType, ElementName=Root}"
                             UnitSettings="{Binding UnitSettings, ElementName=Root}"
                             Minimum="{Binding Minimum, ElementName=Root}"
                             Maximum="{Binding Maximum, ElementName=Root}"
                             Scaled="{Binding Scaled, ElementName=Root}"/>

        <ComboBox Grid.Column="1" 
                  Margin="2,0,0,0"
                  SelectedValue="{Binding UnitType, ElementName=Root}"
                  SelectedValuePath="Value"
                  DisplayMemberPath="Description"
                  MinWidth="60"
                  Height="22">
            <ComboBox.Items>
                <local:UnitTypeItem Value="{x:Static sp:UnitType.Millimeters}" Description="mm"/>
                <local:UnitTypeItem Value="{x:Static sp:UnitType.Inches}" Description="in"/>
            </ComboBox.Items>
        </ComboBox>
    </Grid>
</UserControl>
