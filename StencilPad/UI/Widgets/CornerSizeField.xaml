<UserControl x:Class="StencilPad.UI.Widgets.CornerSizeField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StencilPad.UI.Widgets"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBox Grid.Column="0"
                 Text="{Binding TextValue, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                 VerticalContentAlignment="Center"
                 Padding="4,2"/>

        <ComboBox Grid.Column="1"
                  Margin="4,0,0,0"
                  SelectedValue="{Binding SizeMode, ElementName=Root}"
                  SelectedValuePath="Value"
                  DisplayMemberPath="Description"
                  MinWidth="60">
            <ComboBox.Items>
                <local:CornerSizeField_Item Value="{x:Static local:CornerSizeField_Mode.Millimeters}" Description="mm"/>
                <local:CornerSizeField_Item Value="{x:Static local:CornerSizeField_Mode.Inches}" Description="in"/>
                <local:CornerSizeField_Item Value="{x:Static local:CornerSizeField_Mode.Proportion}" Description="%"/>
            </ComboBox.Items>
        </ComboBox>
    </Grid>
</UserControl>
