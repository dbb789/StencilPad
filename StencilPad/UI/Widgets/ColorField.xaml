<UserControl x:Class="StencilPad.UI.Widgets.ColorField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:widgets="clr-namespace:StencilPad.UI.Widgets"
             MinWidth="160">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="160"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- SV picker -->
        <widgets:ColorFieldSVPicker Grid.Row="0" x:Name="SvPicker"/>

        <!-- Hue slider -->
        <widgets:ColorFieldHueSlider Grid.Row="2" x:Name="HueSlider"/>

        <!-- Alpha slider -->
        <widgets:ColorFieldAlphaSlider Grid.Row="4" x:Name="AlphaSlider"/>

        <!-- Preview + hex -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="26" Height="26"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
                <Grid>
                    <Rectangle>
                        <Rectangle.Fill>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#FFCCCCCC">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,6,6"/>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                        <GeometryDrawing Brush="#FFFFFFFF">
                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <RectangleGeometry Rect="0,0,3,3"/>
                                                    <RectangleGeometry Rect="3,3,3,3"/>
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle x:Name="PreviewRect"/>
                </Grid>
            </Border>
            <TextBox Grid.Column="2" x:Name="HexTextBox"
                     VerticalContentAlignment="Center"
                     Padding="4,2"
                     TextChanged="HexTextBox_TextChanged"/>
        </Grid>
    </Grid>
</UserControl>
