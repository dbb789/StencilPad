<Window x:Class="StencilPad.UI.Properties.MarkerPathPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:widgets="clr-namespace:StencilPad.UI.Widgets"
        xmlns:vm="clr-namespace:StencilPad.ViewModels.Properties"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MarkerPathPropertiesViewModel}"
        Title="{Binding Title}" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        MinWidth="300">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" Executed="Close_Click"/>
    </Window.CommandBindings>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Height="400">
            <TabItem Header="Marker Settings">
                <Grid Margin="8" MinWidth="200" MinHeight="200">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Spacing:"
                               VerticalAlignment="Center"/>
                    <widgets:UnitSliderField Grid.Row="0" Grid.Column="2" MinWidth="180"
                                             Value="{Binding Spacing}"
                                             SliderMinimum="1"
                                             SliderMaximum="10"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Offset:"
                               VerticalAlignment="Center"/>
                    <widgets:UnitSliderField Grid.Row="2" Grid.Column="2" MinWidth="180"
                                             Value="{Binding Offset}"
                                             SliderMinimum="0"
                                             SliderMaximum="100"/>
                </Grid>
            </TabItem>
            <TabItem Header="Marker Colour">
                <widgets:ColorField Margin="8"
                                    Value="{Binding MarkerColor}"/>
            </TabItem>
            <TabItem Header="Line Colour">
                <widgets:ColorField Margin="8"
                                    Value="{Binding LineColor}"/>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Content="Close"
                MinWidth="75" HorizontalAlignment="Right" Click="Close_Click"/>
    </Grid>
</Window>
