<Window x:Class="StencilPad.UI.Properties.ImagePropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:widgets="clr-namespace:StencilPad.UI.Widgets"
        xmlns:vm="clr-namespace:StencilPad.ViewModels.Properties"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ImagePropertiesViewModel}"
        Title="{Binding Title}" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        MinWidth="300">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" Executed="Close_Click"/>
    </Window.CommandBindings>
    <Grid Margin="12" IsEnabled="{Binding HasElements}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Opacity:"/>
        <widgets:AlphaField x:Name="OpacityField"
                            Grid.Row="2"
                            Value="{Binding Opacity}"/>

        <Button Grid.Row="4" Content="Close"
                MinWidth="75" HorizontalAlignment="Right" Click="Close_Click"/>
    </Grid>
</Window>
