<Window x:Class="StencilPad.UI.Dialogs.SheetRenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename Sheet" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        MinWidth="280">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="NameBox" Grid.Row="0" MinWidth="220"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="OK"     IsDefault="True" MinWidth="75" Margin="0,0,8,0" Click="OK_Click"/>
            <Button Content="Cancel" IsCancel="True"  MinWidth="75" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
