<Window x:Class="StencilPad.UI.Dialogs.UnitScaleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unit Scale" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        MinWidth="300">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Scale:"
                   VerticalAlignment="Center"/>
        <TextBox x:Name="NumeratorField"
                 Grid.Row="0" Grid.Column="2"
                 MinHeight="20" MinWidth="60"
                 Text="{Binding Numerator, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Grid.Row="0" Grid.Column="4" Text=":"
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="6"
                 MinHeight="20" MinWidth="60"
                 Text="{Binding Denominator, UpdateSourceTrigger=PropertyChanged}"/>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="OK"     IsDefault="True" MinWidth="75" Margin="0,0,8,0" Click="OK_Click"/>
            <Button Content="Cancel" IsCancel="True"  MinWidth="75" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
