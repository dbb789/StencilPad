<UserControl x:Class="StencilPad.UI.GridButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StencilPad.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="Root">

    <UserControl.Resources>
        <Style x:Key="ToolButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                CornerRadius="2"
                                Background="#FFFFFF"
                                BorderThickness="1.5"
                                BorderBrush="#C0D5EA"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="content"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D0E9FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CCE4F7"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.15"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ListBox Background="Transparent"
             BorderThickness="0"
             Focusable="False">
        <ListBox.ItemContainerStyle>
            <Style TargetType="{x:Type ListBoxItem}">
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ListBox.ItemContainerStyle>

        <ToggleButton Style="{StaticResource ToolButtonStyle}" 
                      IsChecked="{Binding ShowGrid, ElementName=Root}"
                      ToolTip="Show Grid (F1)">
            <Image Source="pack://application:,,,/Resources/Icons/ShowGrid.png"/>
        </ToggleButton>

        <ToggleButton Style="{StaticResource ToolButtonStyle}" 
                      IsChecked="{Binding SnapToGrid, ElementName=Root}"
                      ToolTip="Lock to Grid (F2)">
            <Image Source="pack://application:,,,/Resources/Icons/SnapToGrid.png"/>
        </ToggleButton>

        <ToggleButton Style="{StaticResource ToolButtonStyle}" 
                      IsChecked="{Binding SnapToPoint, ElementName=Root}"
                      ToolTip="Lock to Point (F3)">
            <Image Source="pack://application:,,,/Resources/Icons/SnapToPoint.png"/>
        </ToggleButton>
    </ListBox>
</UserControl>
